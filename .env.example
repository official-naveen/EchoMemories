# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/echomemories?schema=public"

# Long random string (32+ characters) used to sign login tokens and OTP cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me"

# Gmail (or any SMTP) account used to send verification and password-reset codes.
# For Gmail use an "App password", not your normal password.
# If left empty, codes are printed to the server console (development only).
EMAIL_USER=""
EMAIL_PASS=""

# Secret that protects the cron endpoint /api/pulse/check-streak and
# /api/pulse/recalculate-daily. Generate it the same way as JWT_SECRET.
CRON_SECRET="change-me-too"

# Minutes ahead of UTC used to decide when a "day" starts (India = 330).
APP_TZ_OFFSET_MINUTES=330

# Public URL of the site (used for social-preview images). No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
