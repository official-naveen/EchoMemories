{
  "name": "echomemories",
  "version": "1.0.0",
  "private": true,
  "author": "Naveen Kumar (https://github.com/official-naveen)",
  "description": "EchoMemories - a structured social space of echoes, rooms and pulse.",
  "scripts": {
    "predev": "node scripts/doctor.mjs && prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "setup": "node scripts/doctor.mjs --no-db && prisma generate && prisma migrate deploy && node prisma/seed.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:e2e": "node scripts/e2e-rooms.mjs && node scripts/e2e-echoes.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.0.0",
    "jsonwebtoken": "^9.0.3",
    "next": "15.5.28",
    "nodemailer": "^7.0.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "prisma": "^7.10.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
